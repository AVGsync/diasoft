# Infisical connection settings for deploy/infisical-compose.sh and deploy/infisical-compose.ps1

# Cloud: https://app.infisical.com
# EU Cloud: https://eu.infisical.com
# Self-hosted: https://your-infisical.example.com
INFISICAL_ENABLED=true
INFISICAL_API_URL=https://app.infisical.com

# Required
INFISICAL_PROJECT_ID=
INFISICAL_ENV_SLUG=prod
INFISICAL_SECRET_PATH=/

# Recommended auth: Universal Auth machine identity
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# Optional if you use sub-organizations
INFISICAL_AUTH_ORGANIZATION_SLUG=

# Alternative auth methods
INFISICAL_TOKEN=
INFISICAL_SERVICE_TOKEN=

# Optional export flags
INFISICAL_SECRET_TAGS=
INFISICAL_DISABLE_UPDATE_CHECK=true
