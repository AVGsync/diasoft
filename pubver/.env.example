DATABASE_URL=postgres://postgres:postgres@localhost:5432/diasoft?sslmode=disable

# Alternative to DATABASE_URL:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=diasoft
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_SSLMODE=disable

HTTP_ADDR=:8080
REQUEST_TIMEOUT=5s
LOG_LEVEL=info
DB_MAX_CONNS=10
