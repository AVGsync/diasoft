DATABASE_URL=postgres://postgres:postgres@localhost:5432/diasoft?sslmode=disable

# Alternative to DATABASE_URL:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=diasoft
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_SSLMODE=disable

HTTP_ADDR=:8080
REQUEST_TIMEOUT=5s
LOG_LEVEL=info
DB_MAX_CONNS=10
JWT_ENC_SECRET=BTIXrJ+PmLGw8wXqFt37/RIq3PoF5HEXX7kQevleKMA=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_VERIFY_RPS=0.25
RATE_LIMIT_VERIFY_BURST=5
RATE_LIMIT_SEARCH_RPS=0.1
RATE_LIMIT_SEARCH_BURST=3
RATE_LIMIT_KEY_TTL=15m
RATE_LIMIT_REDIS_ADDR=localhost:6379
RATE_LIMIT_REDIS_PASSWORD=
RATE_LIMIT_REDIS_DB=0
RATE_LIMIT_REDIS_PREFIX=rl:pubver
CACHE_ENABLED=false
CACHE_UNIVERSITY_KEY_TTL=30m
CACHE_DIPLOMA_BY_HASH_TTL=1m
CACHE_DIPLOMA_SEARCH_TTL=1m
CACHE_REDIS_ADDR=localhost:6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0
CACHE_REDIS_PREFIX=cache:pubver
ANALYTICS_ENABLED=false
ANALYTICS_KAFKA_BROKERS=localhost:9092
ANALYTICS_KAFKA_TOPIC=verification.events
ANALYTICS_KAFKA_CLIENT_ID=pubver-analytics
ANALYTICS_KAFKA_WRITE_TIMEOUT=3s
ANALYTICS_QUEUE_SIZE=1024
# Optional MaxMind GeoLite2-City.mmdb path for country/city enrichment:
# ANALYTICS_GEOIP_DB_PATH=C:\\geoip\\GeoLite2-City.mmdb
# For localhost GeoIP testing behind Docker/proxy:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12
# For production use only real reverse-proxy CIDRs, not broad private ranges.
# If you want to pass the already-derived AES key directly:
# JWT_ENC_KEY_BASE64=BTIXrJ+PmLGw8wXqFt37/RIq3PoF5HEXX7kQevleKMA=
# Legacy fallback:
# JWT_ENC_KEY_HEX=a81b0915b212084cf98512134278e36ea81b0915b212084cf98512134278e36e
