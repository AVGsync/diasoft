POSTGRES_DB=postgres
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_SSLMODE=disable

REDIS_PASSWORD=change-me-redis-password

PUBLIC_BASE_URL=https://registry.example.com
KAFKA_EXTERNAL_HOST=registry.example.com

# Set to true only when services should fetch secrets from Infisical at runtime.
INFISICAL_ENABLED=false
INFISICAL_API_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENV_SLUG=prod
INFISICAL_SECRET_PATH=/
INFISICAL_TOKEN=
INFISICAL_SERVICE_TOKEN=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_AUTH_ORGANIZATION_SLUG=
INFISICAL_SECRET_TAGS=
INFISICAL_DISABLE_UPDATE_CHECK=true

JWT_SECRET=change-me-gateway-jwt-secret
SHARE_JWT_SECRET=change-me-share-jwt-secret

# Must be base64 and decode to exactly 32 bytes.
SIGNING_KEYS_MASTER_KEY=
QR_PAYLOAD_ENCRYPTION_SECRET=

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Optional demo bootstrap. Leave empty in production.
DEMO_UNIVERSITY_NAME=
DEMO_UNIVERSITY_VUZ_CODE=
DEMO_UNIVERSITY_INN=
DEMO_UNIVERSITY_OGRN=
DEMO_UNIVERSITY_EMAIL=
DEMO_UNIVERSITY_PASSWORD=
DEMO_UNIVERSITY_PRIVATE_KEY_PATH=

TRUSTED_PROXY_CIDRS=

GATEWAY_LOG_LEVEL=info
PUBVER_LOG_LEVEL=info
CRYPTO_RUST_LOG=info,rdkafka=warn,sqlx=warn

GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_CACHE_ENABLED=true
PUBVER_RATE_LIMIT_ENABLED=true
PUBVER_CACHE_ENABLED=true
PUBVER_ANALYTICS_ENABLED=true

BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,::1,postgres,kafka,redis,gateway-service,pubver,frontend
